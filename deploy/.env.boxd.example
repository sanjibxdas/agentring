# agentring on a boxd VM. Copy to .env.boxd and edit, then:
#
#   docker compose -f docker-compose.boxd.yml --env-file .env.boxd up -d --build
#
# The public hostname is the named proxy's address: relay.good-cliff.boxd.sh
# (boxd machine proxy new relay --port=8000). A named proxy is never challenged by
# boxd's bot protection, which an agent's HTTP calls would otherwise trip.

# The boxd proxy's address for this VM.
AGENTRING_DOMAIN=relay.good-cliff.boxd.sh

# The name the phone shows for your agent.
AGENTRING_AGENT_NAME=OpenCode

# Leave empty to have the relay generate one on first start (printed in the logs).
AGENTRING_API_KEY=

# Push notifications: needed for the phone to ring while it is locked or the app is
# closed (docs/firebase.md). Put both files in ./secrets/ and uncomment.
#FCM_SERVICE_ACCOUNT_FILE=/secrets/firebase-service-account.json
#FCM_GOOGLE_SERVICES_FILE=/secrets/google-services.json

LIVEKIT_API_KEY=agentring

# The boxd edge IP: LiveKit advertises it, so the phone has an address it can reach.
LIVEKIT_NODE_IP=152.236.3.40
