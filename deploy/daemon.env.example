# The agentring daemon's configuration for a boxd VM.
#
# Copy to ~/.agentring/.env and fill in. The directory is mode 700 and the file
# mode 600: the API key is the daemon's credential for the relay, and the
# voice provider's key is a billable credential.
#
#   cp deploy/daemon.env.example ~/.agentring/.env
#   chmod 600 ~/.agentring/.env

# The voice provider. "deepgram" is the one added in this repository;
# "gemini", "openai", "grok" and "phonic" are upstream's.
AGENTRING_VOICE_PROVIDER=deepgram

# Deepgram's API key: https://console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key

# The LLM stage Deepgram uses to run the conversation. "gpt-4o-mini" is the one
# model that does not call the tools reliably, so it is not the default.
# DEEPGRAM_THINK_MODEL=gpt-5.4-mini
# DEEPGRAM_THINK_PROVIDER=open_ai

# The relay's API key, written by `agentring init`. Do not put it here:
# `agentring init` stores it in ~/.agentring/.env itself.
# AGENTRING_API_KEY=ak_...
